#-----------------------------------#
# Application
#-----------------------------------#
APP_VERSION=0.1.0
PROJECT_NAME=WDL Core API
PROJECT_DESC=API системы визуализации связей баз данных
ENVIRONMENT=development
DEBUG=False
API_EXPOSE_PORT=8001
LOG_LEVEL=INFO
LOG_JSON=False

CORS_DISABLE=True
CORS_REGEX=https://.*\.wdl\.ru
PROD_SERVER_URL=


#-----------------------------------#
# PostgreSQL
#-----------------------------------#
POSTGRES_SERVER=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=wdl
POSTGRES_PORT=5432
SQLALCHEMY_ECHO=False
DATABASE_CREATE_TABLES=True


#-----------------------------------#
# Identity / JWT
#-----------------------------------#
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=wdl-identity
JWT_AUDIENCE=wdl-api
IDENTITY_TOKEN_URL=http://localhost:8002/oauth/token
